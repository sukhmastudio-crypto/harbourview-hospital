# Where the contact and booking forms send submissions (server side, recommended).
# Use a Zapier / Make / Formspree / your own CRM webhook URL. Leave empty for demo mode.
FORM_WEBHOOK_URL=

# Optional: post forms straight from the browser to a service like Formspree instead of /api/enquiry.
NEXT_PUBLIC_FORM_ENDPOINT=

# Your live domain (used for sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://www.example.com.au
